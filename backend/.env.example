PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_parkir

JWT_SECRET=ganti_dengan_secret_key_anda

# URL frontend (dipakai membentuk link reset password di email)
FRONTEND_URL=http://localhost:5173

# SMTP untuk kirim email reset password (opsional saat development).
# Kosongkan semuanya untuk mode demo: token reset ditampilkan langsung
# di halaman (hanya jika NODE_ENV bukan "production").
# Contoh Gmail: host smtp.gmail.com, port 587, pass = App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sistem Parkir <noreply@example.com>"

# Kamera pengenal plat nomor & warna kendaraan (halaman Parkir > Masuk via Kamera).
# Buat API key di https://console.anthropic.com lalu isi di sini.
# Kosongkan = tombol kamera tetap tampil tapi scan ditolak dengan pesan jelas,
# petugas masih bisa mengisi plat & warna manual.
ANTHROPIC_API_KEY=
ANPR_MODEL=claude-sonnet-5-5
